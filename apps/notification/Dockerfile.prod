# ============================================
# STAGE 1: Base - Shared setup for all stages
# ============================================
FROM node:24-alpine AS base

# Enable pnpm via corepack (built into Node 16.13+)
RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

# ============================================
# STAGE 2: Build - Compile TypeScript
# ============================================
FROM base AS build

# Copy lockfile and workspace config first (better layer caching)
COPY pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy package.json and tsconfig.json for both packages
COPY apps/notification/package.json apps/notification/tsconfig.json ./apps/notification/
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/

# Install dependencies (cached if lockfile unchanged)
RUN --mount=type=cache,target=/pnpm/store pnpm install --frozen-lockfile

# Copy source code
COPY apps/notification ./apps/notification
COPY packages/shared ./packages/shared

# Build both packages (shared first since notification depends on it)
RUN pnpm --filter @joblensai/shared build && \
    pnpm --filter notification build

# Create standalone production package
RUN pnpm --filter notification deploy --legacy /prod

# Fix: Copy compiled files to correct locations
# - notification's compiled JS goes to /prod/dist
# - shared's compiled JS goes to src/ path (because imports use @joblensai/shared/src/...)
RUN cp -r apps/notification/dist /prod/dist && \
    rm -rf /prod/node_modules/@joblensai/shared/src && \
    cp -r packages/shared/dist /prod/node_modules/@joblensai/shared/src

# Download AWS DocumentDB CA bundle for TLS connection in production
RUN mkdir -p /app/certs && \
    wget -q -O /app/certs/global-bundle.pem \
    https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

# ============================================
# STAGE 3: Runtime - Minimal production image
# ============================================
FROM node:24-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Install Chromium and dependencies for Puppeteer in production
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-liberation

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Copy AWS DocumentDB CA cert (needed for TLS in production)
COPY --from=build --chown=appuser:appgroup /app/certs/global-bundle.pem /app/certs/global-bundle.pem

# Copy built application from build stage
COPY --from=build --chown=appuser:appgroup /prod ./

USER appuser
EXPOSE 5005

# Run compiled JavaScript
CMD ["node", "dist/index.js"]
