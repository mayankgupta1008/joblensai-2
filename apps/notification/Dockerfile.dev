FROM node:24-alpine

RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Headless-only Chromium for Puppeteer (same set as Dockerfile.prod); DejaVu adds the Rupee sign glyph Liberation lacks.
# Mesa's software GPU stack (LLVM, gallium) is never loaded for PDF printing, so drop it in this same layer.
RUN apk add --no-cache chromium-headless-shell ttf-liberation font-dejavu && \
    rm -rf /usr/lib/libLLVM* /usr/lib/llvm[0-9]* /usr/lib/libgallium-*.so /usr/lib/gbm/dri_gbm.so /usr/lib/dri

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-headless-shell

WORKDIR /app

# Copy workspace configuration and lockfile
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

# Copy package.json files for the service and its local dependencies
COPY apps/notification/package.json ./apps/notification/
COPY packages/shared/package.json ./packages/shared/
COPY packages/eslint-config/package.json ./packages/eslint-config/

# Install dependencies (pnpm's metadata cache goes to a cache mount, not into the image)
RUN --mount=type=cache,target=/pnpm/store \
    --mount=type=cache,target=/root/.cache/pnpm \
    pnpm install

# We don't COPY the source code here because we will mount it as a volume
# in docker-compose.

EXPOSE 5005

CMD ["pnpm", "--filter", "notification", "dev"]
