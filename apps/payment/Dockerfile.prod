# ============================================
# STAGE 1: Base - Shared setup for all stages
# ============================================
FROM node:24-alpine AS base

# Enable pnpm via corepack (built into Node 16.13+)
RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

# ============================================
# STAGE 2: Build - Compile TypeScript
# ============================================
FROM base AS build

# Copy lockfile and workspace config first (better layer caching)
COPY pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy package.json and tsconfig.json for both packages
COPY apps/payment/package.json apps/payment/tsconfig.json ./apps/payment/
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/

# Install dependencies (cached if lockfile unchanged)
RUN --mount=type=cache,target=/pnpm/store pnpm install --frozen-lockfile

# Copy source code
COPY apps/payment ./apps/payment
COPY packages/shared ./packages/shared

# Build both packages (shared first since payment depends on it)
RUN pnpm --filter @joblensai/shared build && \
    pnpm --filter payment build

# Create standalone production package
RUN pnpm --filter payment deploy --legacy /prod

# Fix: Copy compiled files to correct locations
# - payment's compiled JS goes to /prod/dist
# - shared's compiled JS goes to src/ path (because imports use @joblensai/shared/src/...)
RUN cp -r apps/payment/dist /prod/dist && \
    rm -rf /prod/node_modules/@joblensai/shared/src && \
    cp -r packages/shared/dist /prod/node_modules/@joblensai/shared/src

# ============================================
# STAGE 3: Runtime - Minimal production image
# ============================================
FROM node:24-alpine AS runtime

# Install Chromium for Puppeteer
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

# Tell Puppeteer to use installed Chromium instead of downloading
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV NODE_ENV=production

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Copy built application from build stage
COPY --from=build --chown=appuser:appgroup /prod ./

USER appuser
EXPOSE 5004

# Run compiled JavaScript
CMD ["node", "dist/index.js"]
