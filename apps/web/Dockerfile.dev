FROM node:24-alpine

RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

# Copy workspace configuration and lockfile
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy package.json files for the service and its local dependencies
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/eslint-config/package.json ./packages/eslint-config/

# Install dependencies
RUN --mount=type=cache,target=/pnpm/store \
    pnpm install

# We don't COPY the source code here because we will mount it as a volume
# in docker-compose. However, we need the initial structure for pnpm to work.

EXPOSE 5173

CMD ["sh", "-c", "\
  HASH=$(md5sum /app/pnpm-lock.yaml | cut -d' ' -f1); \
  HASH_FILE=/app/.web_pkg_hash; \
  if [ ! -f $HASH_FILE ] || [ \"$(cat $HASH_FILE)\" != \"$HASH\" ]; then \
    echo 'deps changed, installing...' && pnpm install --frozen-lockfile && echo $HASH > $HASH_FILE; \
  fi && pnpm --filter web dev"]

