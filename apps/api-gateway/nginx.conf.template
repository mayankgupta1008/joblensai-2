events {
    worker_connections 1024;
}

http {
    include mime.types;
    default_type application/octet-stream;

    # DNS resolver for periodic re-resolution of upstream `server ... resolve;` entries.
    # Docker: 127.0.0.11 | k8s: 10.96.0.10 | ECS: 169.254.169.253 (VPC DNS / Route53)
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    # ─────────────────────────────────────────────────────────────
    # Upstreams — `resolve` (nginx OSS 1.27.3+) re-resolves periodically
    # so cold-start race + IP churn are handled without nginx restart.
    # ─────────────────────────────────────────────────────────────
    upstream auth_service {
        zone auth_zone 64k;
        server ${AUTH_URL}:5003 resolve;
    }

    upstream backend_service {
        zone backend_zone 64k;
        server ${BACKEND_URL}:5001 resolve;
    }

    upstream payment_service {
        zone payment_zone 64k;
        server ${PAYMENT_URL}:5004 resolve;
    }

    upstream agent_service {
        zone agent_zone 64k;
        server ${AGENT_URL}:5002 resolve;
    }

    upstream notification_service {
        zone notification_zone 64k;
        server ${NOTIFICATION_URL}:5005 resolve;
    }

    upstream frontend_service {
        zone frontend_zone 64k;
        server ${FRONTEND_URL}:5173 resolve;
    }

    upstream mongo_express_service {
        zone mongo_express_zone 64k;
        server ${MONGO_EXPRESS_URL}:8081 resolve;
    }

    upstream kafka_ui_service {
        zone kafka_ui_zone 64k;
        server ${KAFKA_UI_URL}:8080 resolve;
    }

    upstream redis_insight_service {
        zone redis_insight_zone 64k;
        server ${REDIS_INSIGHT_URL}:5540 resolve;
    }

    upstream minio_service {
        zone minio_zone 64k;
        server ${MINIO_URL}:9001 resolve;
    }

    # Trust reverse proxies (AWS ALB / Docker) to provide the true Client IP
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;

    proxy_cache_path /tmp/auth_cache levels=1:2 keys_zone=auth_cache:10m max_size=100m inactive=5m;

    map $http_x_forwarded_proto $proxy_x_forwarded_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    server {
        listen 80;

        # ─────────────────────────────────────────
        # Internal auth validation
        # ─────────────────────────────────────────
        location = /_validate_token {
            internal;
            proxy_pass http://auth_service/api/auth/validate;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie $http_cookie;

            proxy_cache auth_cache;
            proxy_cache_key $http_authorization$http_cookie;
            proxy_cache_valid 200 5m;
            proxy_cache_valid 401 403 1m;
        }

        # ─────────────────────────────────────────
        # Frontend
        # ─────────────────────────────────────────
        location / {
            proxy_pass http://frontend_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        # ─────────────────────────────────────────
        # Auth (public)
        # ─────────────────────────────────────────
        location /api/auth/ {
            limit_req zone=auth_limit burst=10 nodelay;

            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie $http_cookie;
        }

        # ─────────────────────────────────────────
        # Health
        # ─────────────────────────────────────────
        location = /health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 'OK';
        }

        location = /api/backend/health {
            proxy_pass http://backend_service/api/backend/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        location = /api/payment/health {
            proxy_pass http://payment_service/api/payment/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        location = /api/agent-service/health {
            proxy_pass http://agent_service/api/agent-service/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        location = /api/notification/health {
            proxy_pass http://notification_service/api/notification/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        # ─────────────────────────────────────────
        # WebSocket
        # ─────────────────────────────────────────
        location /socket.io/ {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            proxy_pass http://notification_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header Cookie $http_cookie;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_connect_timeout 30s;
        }

        # ─────────────────────────────────────────
        # Backend (protected)
        # ─────────────────────────────────────────
        location ~ ^/api/(account|file) {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            auth_request_set $user_role $upstream_http_x_user_role;
            proxy_pass http://backend_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header X-User-Role $user_role;
            proxy_set_header Authorization "";
        }

        # ─────────────────────────────────────────
        # Payment
        # ─────────────────────────────────────────
        location = /api/payment/webhook {
            proxy_pass http://payment_service/api/payment/webhook;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        location /api/payment/ {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            auth_request_set $user_role $upstream_http_x_user_role;
            proxy_pass http://payment_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header X-User-Role $user_role;
            proxy_set_header Authorization "";
            proxy_set_header X-Idempotency-Key $http_x_idempotency_key;
        }

        # ─────────────────────────────────────────
        # Agent
        # ─────────────────────────────────────────
        location /api/agent/ {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            auth_request_set $user_role $upstream_http_x_user_role;
            proxy_pass http://agent_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header X-User-Role $user_role;
            proxy_set_header Authorization "";
        }

        # ─────────────────────────────────────────
        # Notification
        # ─────────────────────────────────────────
        location /api/notifications/ {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            auth_request_set $user_role $upstream_http_x_user_role;
            proxy_pass http://notification_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header X-User-Role $user_role;
            proxy_set_header Authorization "";
        }

        # ─────────────────────────────────────────
        # Admin tools
        # ─────────────────────────────────────────
        location /mongo-express {
            proxy_pass http://mongo_express_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_redirect off;
        }

        location /kafka-ui {
            proxy_pass http://kafka_ui_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_redirect off;
        }

        location /redis-insight/ {
            proxy_pass http://redis_insight_service/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_redirect off;
        }

        location /minio-ui/ {
            rewrite ^/minio-ui/(.*) /$1 break;
            proxy_pass http://minio_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_redirect / /minio-ui/;
            proxy_set_header Accept-Encoding "";
            sub_filter_once off;
            sub_filter_types text/html;
            sub_filter '<base href="/"/>' '<base href="/minio-ui/"/>';
            sub_filter 'href="./' 'href="/minio-ui/';
            sub_filter 'src="./' 'src="/minio-ui/';
        }
    }
}