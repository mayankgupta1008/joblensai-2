events {
    worker_connections 1024;
}

http {
    include mime.types;
    default_type application/octet-stream;

    # Docker's embedded DNS resolver for dynamic upstream resolution
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    # Trust reverse proxies (AWS ALB / Docker) to provide the true Client IP
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Rate limiting: 5 requests/sec per IP (Now correctly uses true Client IP)
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;

    # Cache for auth validation responses
    proxy_cache_path /tmp/auth_cache levels=1:2 keys_zone=auth_cache:10m max_size=100m inactive=5m;

    # Trust X-Forwarded-Proto from upstream load balancer (Render, Vercel, etc.)
    map $http_x_forwarded_proto $proxy_x_forwarded_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    server {
        listen 80;

        # ─────────────────────────────────────────────────────────────
        # Internal auth validation endpoint
        # ─────────────────────────────────────────────────────────────
        location = /_validate_token {
            internal;
            set $auth_upstream ${AUTH_URL}:5003;
            proxy_pass http://$auth_upstream/api/auth/validate;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie $http_cookie;

            # Cache auth responses to reduce load on auth service
            proxy_cache auth_cache;
            proxy_cache_key $http_authorization$http_cookie;
            proxy_cache_valid 200 5m;
            proxy_cache_valid 401 403 1m;
        }

        # ─────────────────────────────────────────────────────────────
        # Frontend (dev: 5173, prod: 80)
        # ─────────────────────────────────────────────────────────────
        location / {
            set $frontend_upstream ${FRONTEND_URL}:5173;
            proxy_pass http://$frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        # ─────────────────────────────────────────────────────────────
        # Auth Service - Public routes (no auth required)
        # ─────────────────────────────────────────────────────────────
        location /api/auth/ {
            limit_req zone=auth_limit burst=10 nodelay;

            set $auth_upstream ${AUTH_URL}:5003;
            proxy_pass http://$auth_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie $http_cookie;
        }

        # ─────────────────────────────────────────────────────────────
        # Health Checks - No auth required
        # ─────────────────────────────────────────────────────────────
        location = /api/backend/health {
            set $backend_upstream ${BACKEND_URL}:5001;
            proxy_pass http://$backend_upstream/api/backend/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        location = /api/payment/health {
            set $payment_upstream ${PAYMENT_URL}:5004;
            proxy_pass http://$payment_upstream/api/payment/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        location = /api/agent-service/health {
            set $agent_upstream ${AGENT_URL}:5002;
            proxy_pass http://$agent_upstream/api/agent-service/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        location = /api/notification/health {
            set $notification_upstream ${NOTIFICATION_URL}:5005;
            proxy_pass http://$notification_upstream/api/notification/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        # ─────────────────────────────────────────────────────────────
        # Notification WebSocket Service
        # ─────────────────────────────────────────────────────────────
        location /socket.io/ {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            set $notification_upstream ${NOTIFICATION_URL}:5005;
            proxy_pass http://$notification_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header Cookie $http_cookie;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_connect_timeout 30s;
        }

        # ─────────────────────────────────────────────────────────────
        # Backend Service - Protected
        # ─────────────────────────────────────────────────────────────
        location ~ ^/api/(account|file) {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            auth_request_set $user_role $upstream_http_x_user_role;
            set $backend_upstream ${BACKEND_URL}:5001;
            proxy_pass http://$backend_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header X-User-Role $user_role;
            proxy_set_header Authorization "";
        }

        # ─────────────────────────────────────────────────────────────
        # Payment Service - Webhook (Public)
        # ─────────────────────────────────────────────────────────────
        location = /api/payment/webhook {
            set $payment_upstream ${PAYMENT_URL}:5004;
            proxy_pass http://$payment_upstream/api/payment/webhook;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        # ─────────────────────────────────────────────────────────────
        # Payment Service - Protected
        # ─────────────────────────────────────────────────────────────
        location /api/payment/ {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            auth_request_set $user_role $upstream_http_x_user_role;
            set $payment_upstream ${PAYMENT_URL}:5004;
            proxy_pass http://$payment_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header X-User-Role $user_role;
            proxy_set_header Authorization "";
            proxy_set_header X-Idempotency-Key $http_x_idempotency_key;
        }

        # ─────────────────────────────────────────────────────────────
        # Agent Service - Protected
        # ─────────────────────────────────────────────────────────────
        location /api/agent/ {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            auth_request_set $user_role $upstream_http_x_user_role;
            set $agent_upstream ${AGENT_URL}:5002;
            proxy_pass http://$agent_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header X-User-Role $user_role;
            proxy_set_header Authorization "";
        }

        # ─────────────────────────────────────────────────────────────
        # Notification Service - Protected
        # ─────────────────────────────────────────────────────────────
        location /api/notifications/ {
            auth_request /_validate_token;
            auth_request_set $user_id $upstream_http_x_user_id;
            auth_request_set $user_role $upstream_http_x_user_role;
            set $notifications_upstream ${NOTIFICATION_URL}:5005;
            proxy_pass http://$notifications_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-User-Id $user_id;
            proxy_set_header X-User-Role $user_role;
            proxy_set_header Authorization "";
        }

        # ─────────────────────────────────────────────────────────────
        # Admin Tools (optional - 502 if not running)
        # Apps configured with base paths via docker-compose env vars
        # ─────────────────────────────────────────────────────────────

        # Mongo Express (ME_CONFIG_SITE_BASEURL=/mongo-express)
        location /mongo-express {
            set $mongo_express_upstream ${MONGO_EXPRESS_URL}:8081;
            proxy_pass http://$mongo_express_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_redirect off;
        }

        # Kafka UI (SERVER_SERVLET_CONTEXT_PATH=/kafka-ui)
        location /kafka-ui {
            set $kafka_ui_upstream ${KAFKA_UI_URL}:8080;
            proxy_pass http://$kafka_ui_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_redirect off;
        }

        # Redis Insight - no native base path support, access directly at localhost:5540
        location /redis-insight/ {
            set $redis_insight_upstream ${REDIS_INSIGHT_URL}:5540;
            proxy_pass http://$redis_insight_upstream/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_redirect off;
        }

        # MinIO Console - strip prefix and rewrite HTML for subpath serving
        location /minio-ui/ {
            set $minio_ui_upstream ${MINIO_URL}:9001;
            rewrite ^/minio-ui/(.*) /$1 break;
            proxy_pass http://$minio_ui_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_redirect / /minio-ui/;
            proxy_set_header Accept-Encoding "";
            sub_filter_once off;
            sub_filter_types text/html;
            sub_filter '<base href="/"/>' '<base href="/minio-ui/"/>';
            sub_filter 'href="./' 'href="/minio-ui/';
            sub_filter 'src="./' 'src="/minio-ui/';
        }
    }
}