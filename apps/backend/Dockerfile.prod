# ============================================
# STAGE 1: Base - Shared setup for all stages
# ============================================
FROM node:24-alpine AS base

# Enable pnpm via corepack (built into Node 16.13+)
RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

# ============================================
# STAGE 2: Build - Compile TypeScript
# ============================================
FROM base AS build

# Copy package.json files for all workspace packages first (satisfies workspace integrity)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/*/package.json ./apps/
COPY packages/*/package.json ./packages/

# Copy tsconfig files specifically for the build
COPY apps/backend/tsconfig.json ./apps/backend/
COPY packages/shared/tsconfig.json ./packages/shared/

# Install dependencies (cached if lockfile unchanged)
RUN --mount=type=cache,target=/pnpm/store pnpm install --frozen-lockfile

# Copy source code
COPY apps/backend ./apps/backend
COPY packages/shared ./packages/shared

# Build both packages (shared first since backend may depend on it)
RUN pnpm --filter @joblensai/shared build && \
    pnpm --filter backend build

# Create standalone production package
RUN pnpm --filter backend deploy --legacy /prod

# Copy compiled files to correct locations
# - backend's compiled JS goes to /prod/dist
# - shared's compiled JS goes to src/ path (if imports use @joblensai/shared/src/...)
RUN cp -r apps/backend/dist /prod/dist && \
    rm -rf /prod/node_modules/@joblensai/shared/src && \
    cp -r packages/shared/dist /prod/node_modules/@joblensai/shared/src

# Download AWS DocumentDB CA bundle for TLS connection in production
RUN mkdir -p /app/certs && \
    wget -q -O /app/certs/global-bundle.pem \
    https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

# ============================================
# STAGE 3: Runtime - Minimal production image
# ============================================
FROM node:24-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Copy built application from build stage
COPY --from=build --chown=appuser:appgroup /prod ./

# Copy AWS DocumentDB CA cert (needed for TLS in production)
COPY --from=build --chown=appuser:appgroup /app/certs/global-bundle.pem /app/certs/global-bundle.pem

USER appuser
EXPOSE 5001

# Run compiled JavaScript
CMD ["node", "dist/index.js"]
