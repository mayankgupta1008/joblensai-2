{
  "name": "joblensai",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.28.2"
  },
  "scripts": {
    "dev:up": "docker-compose -f infra/local-docker/docker-compose.yaml up -d --build --remove-orphans",
    "dev:down": "docker-compose -f infra/local-docker/docker-compose.yaml down",
    "dev:nuke": "docker-compose -f infra/local-docker/docker-compose.yaml down -v --remove-orphans",
    "dev:rebuild": "docker-compose -f infra/local-docker/docker-compose.yaml build --no-cache && docker-compose -f infra/local-docker/docker-compose.yaml up -d --remove-orphans",
    "dev:restart": "docker-compose -f infra/local-docker/docker-compose.yaml restart",
    "mobile:up": "pnpm --filter mobile start --ios",
    "lint": "eslint apps packages",
    "lint:fix": "eslint apps packages --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "k8s:deploy": "./infra/local-k8s/scripts/deploy-local.sh",
    "k8s:nuke": "./infra/local-k8s/scripts/stop-local.sh",
    "k8s:push": "./infra/local-k8s/scripts/push-to-gitea.sh",
    "cloud:deploy": "./infra/cloud-deploy/scripts/deploy.sh",
    "cloud:toolbox": "./infra/cloud-deploy/scripts/aws-cli-docker.sh",
    "cloud:nuke": "./infra/cloud-deploy/scripts/nuke.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@joblensai/eslint-config": "workspace:*",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
